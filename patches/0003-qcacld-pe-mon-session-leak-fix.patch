diff --git a/vendor/qcom/opensource/wlan/qcacld-3.0/core/mac/src/pe/lim/lim_api.c b/vendor/qcom/opensource/wlan/qcacld-3.0/core/mac/src/pe/lim/lim_api.c
index 011dc26..96f27fc 100644
--- a/vendor/qcom/opensource/wlan/qcacld-3.0/core/mac/src/pe/lim/lim_api.c
+++ b/vendor/qcom/opensource/wlan/qcacld-3.0/core/mac/src/pe/lim/lim_api.c
@@ -3378,11 +3378,36 @@ void lim_mon_deinit_session(struct mac_context *mac_ptr,
 			    struct sir_delete_session *msg)
 {
 	struct pe_session *session;
+	uint8_t i;
 
 	session = pe_find_session_by_vdev_id(mac_ptr, msg->vdev_id);
 
-	if (session && session->bssType == eSIR_MONITOR_MODE)
+	if (session && session->bssType == eSIR_MONITOR_MODE) {
 		pe_delete_session(mac_ptr, session);
+		return;
+	}
+
+	/*
+	 * MONDBG: vdev_id lookup failed or type mismatch. Historically this
+	 * branch returned silently; a monitor PE session left behind here is
+	 * never freed (pe_create_session eventually fails with "Reached max
+	 * sessions" after repeated monitor add/del cycles). Monitor mode has
+	 * at most one session at a time, so fall back to a type scan and
+	 * reclaim any leaked eSIR_MONITOR_MODE slot.
+	 */
+	pe_err("MONDBG mon deinit: vdev_id=%u lookup failed (found=%d), falling back to type scan",
+	       msg->vdev_id, !!session);
+	for (i = 0; i < mac_ptr->lim.maxBssId; i++) {
+		if (mac_ptr->lim.gpSession[i].valid &&
+		    mac_ptr->lim.gpSession[i].bssType == eSIR_MONITOR_MODE) {
+			pe_err("MONDBG mon deinit: reclaiming leaked monitor slot[%d] vdev_id=%d",
+			       i, mac_ptr->lim.gpSession[i].vdev_id);
+			pe_delete_session(mac_ptr,
+					  &mac_ptr->lim.gpSession[i]);
+			return;
+		}
+	}
+	pe_err("MONDBG mon deinit: no monitor session present (nothing to reclaim)");
 }
 
